{
  "root": true,
  "parserOptions": { "ecmaVersion": 2021, "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "env": { "browser": true, "es2021": true, "node": true },
  "plugins": ["react-hooks"],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "no-undef": "error",
    "no-unused-vars": "off"
  },
  "globals": { "React": "readonly" }
}
